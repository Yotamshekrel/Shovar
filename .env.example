# Copy to .env.local (git-ignored) and fill in what you need. All are optional.
# EXPO_PUBLIC_* values are inlined into the JS bundle at build time.

# --- Receipt extraction (Claude vision) ---
# Run the proxy in server/ and point the app at it. The proxy holds the real
# Anthropic key; the app never sees it (users can also paste their own in Settings).
EXPO_PUBLIC_ANTHROPIC_BASE_URL=
# Shared token checked by the proxy (PROXY_CLIENT_TOKEN). NOT an Anthropic key.
EXPO_PUBLIC_PROXY_CLIENT_TOKEN=
# Model used for extraction (default: claude-opus-5-5).
EXPO_PUBLIC_EXTRACTION_MODEL=

# --- Store locations for nearby reminders ---
# Optional. Without it, store branches are looked up on OpenStreetMap (Overpass).
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=
